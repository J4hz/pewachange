# Copy this file to .env.local and fill in real values before deploying.
# All variables are optional in dev — the site degrades gracefully (leads
# queue locally, analytics simply never load) when they're blank.

# Where lead-capture form submissions (ward join, volunteer/ward captain
# interest) are POSTed as JSON. Point this at a Formspree endpoint, a Google
# Apps Script Web App bound to a Sheet, or the campaign's own backend/CRM
# webhook. Example (Formspree): https://formspree.io/f/xxxxxxx
VITE_LEADS_ENDPOINT=

# Where the Get Involved contact form is POSTed as JSON. Point this at a
# Formspree endpoint (or similar) configured to deliver to info@pewachange.ke,
# or the campaign's own mail-sending backend.
# Example (Formspree): https://formspree.io/f/xxxxxxx
VITE_CONTACT_ENDPOINT=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to disable Google Analytics entirely.
VITE_GA_ID=

# Meta (Facebook) Pixel ID.
# Leave blank to disable the Meta Pixel entirely.
VITE_META_PIXEL_ID=
