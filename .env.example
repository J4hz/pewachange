# Copy this file to .env.local and fill in real values before deploying.
# All variables are optional in dev — the site degrades gracefully (form
# submissions queue locally and are retried on a later visit, analytics
# simply never load) when they're blank.
#
# On Vercel these must also be set in Project Settings -> Environment
# Variables. They are baked in at BUILD time, so changing one requires a
# redeploy before it takes effect.

# Where lead-capture form submissions (ward join, volunteer/ward captain
# interest) are POSTed as JSON. Point this at the Google Apps Script Web App
# described in the README ("Wiring up lead capture and campaign updates"), a
# Formspree endpoint, or the campaign's own backend/CRM webhook.
# Example (Apps Script): https://script.google.com/macros/s/AKfy.../exec
# Example (Formspree):   https://formspree.io/f/xxxxxxx
VITE_LEADS_ENDPOINT=

# Where the Get Involved contact form is POSTed as JSON. If you're using the
# Apps Script collector, set this to the SAME URL as VITE_LEADS_ENDPOINT —
# the script routes by the payload's `form` field and writes messages to a
# separate "Messages" tab. Otherwise point it at a Formspree endpoint (or
# similar) configured to deliver to info@pewachange.ke.
VITE_CONTACT_ENDPOINT=

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave blank to disable Google Analytics entirely.
VITE_GA_ID=

# Meta (Facebook) Pixel ID.
# Leave blank to disable the Meta Pixel entirely.
VITE_META_PIXEL_ID=
